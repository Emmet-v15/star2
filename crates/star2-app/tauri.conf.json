{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "star2",
  "version": "0.4.5",
  "identifier": "studio.v15.star2",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "star2",
        "label": "main",
        "width": 460,
        "height": 340,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}